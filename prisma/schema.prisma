// Schema do banco de dados — Controle Operacional de Armazém
// Rodar `npx prisma generate` após instalar dependências
// Rodar `npx prisma migrate dev --name init` para criar as tabelas em desenvolvimento

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Papel {
  ADMIN
  OPERADOR
  CONFERENTE
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  senhaHash String
  papel     Papel    @default(OPERADOR)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  processosCriados Processo[] @relation("ProcessoCriadoPor")
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  cnpj      String?
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  usaPalletProprio Boolean @default(false) // se true, habilita o módulo de saldo de pallets do cliente

  processos        Processo[]
  avarias          Avaria[]
  presencasCarga   PresencaCarga[]
  movimentosPallet MovimentoPallet[]
  inventarios      Inventario[]
}

// Controle diário de processos (chegada -> liberação -> operação)
model Processo {
  id        String   @id @default(cuid())
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  clienteId String

  data              DateTime @default(now())
  placaVeiculo      String
  motorista         String?
  transportadora    String?  // nome da transportadora/carreteiro (da base externa)
  tipoOperacao      String   // ex: Carga, Descarga, Entrega
  numeroReferencia  String?  // NF, pedido, referência interna — pode conter várias NFs separadas por vírgula
  quantidadeNotas   Int?     @default(1) // "Qtde NF" — total de notas desse processo

  horaChegada       DateTime?
  horaLiberacao     DateTime?
  horaInicioOp      DateTime?
  horaFimOp         DateTime?

  observacoes       String?
  status            String   @default("EM_ANDAMENTO") // EM_ANDAMENTO, FINALIZADO, CANCELADO

  criadoPor         Usuario? @relation("ProcessoCriadoPor", fields: [criadoPorId], references: [id])
  criadoPorId       String?
  criadoEm          DateTime @default(now())

  servicos          ServicoUtilizado[]
}

// Serviços utilizados em cada processo (pallet, stretch, etc.)
model ServicoUtilizado {
  id          String   @id @default(cuid())
  processo    Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  processoId  String

  tipoServico String   // PALLET, STRETCH, OUTRO
  quantidade  Decimal  @default(0)
  unidade     String   @default("UN") // UN, KG, ROLO...
  palletProprioCliente Boolean @default(false) // se true, esta quantidade é abatida do saldo de pallets do cliente (não é cobrada)
  observacao  String?

  criadoEm    DateTime @default(now())
}

// Controle de saldo de pallets próprios do cliente (compra e consumo)
model MovimentoPallet {
  id         String   @id @default(cuid())
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  clienteId  String

  tipo       String   // ENTRADA_COMPRA, SAIDA_CONSUMO, AJUSTE
  quantidade Decimal
  referencia String?  // nota de compra, processo relacionado etc.
  data       DateTime @default(now())
  observacao String?

  criadoEm   DateTime @default(now())
}

// Controle de avarias
model Avaria {
  id             String   @id @default(cuid())
  cliente        Cliente  @relation(fields: [clienteId], references: [id])
  clienteId      String

  codigoProduto  String
  descricao      String
  lote           String?
  numeroNota     String?
  origem         String   @default("ORIGEM") // ORIGEM (avaria de origem) ou RADAR (avaria interna monitorada)
  pesoAvaria     Decimal
  localizacao    String?  // endereço/posição no armazém
  varredura      Boolean  @default(false) // se a avaria foi identificada em varredura
  quantidadeVarreduraKg Decimal? // preenchido só quando varredura = true
  fotoUrl        String?
  observacao     String?

  data           DateTime @default(now())
  criadoEm       DateTime @default(now())
}

// Presença de carga — formalização da chegada de material (uma nota, vários produtos)
model PresencaCarga {
  id             String   @id @default(cuid())
  cliente        Cliente  @relation(fields: [clienteId], references: [id])
  clienteId      String

  fornecedor     String
  numeroNota     String
  dataChegada    DateTime @default(now())
  observacao     String?
  statusProcesso String   @default("PENDENTE") // PENDENTE ou CLASSIFICADO — se o processo já foi lançado no sistema

  criadoEm       DateTime @default(now())

  itens          PresencaCargaItem[]
}

model PresencaCargaItem {
  id              String        @id @default(cuid())
  presencaCarga   PresencaCarga @relation(fields: [presencaCargaId], references: [id], onDelete: Cascade)
  presencaCargaId String

  codigoProduto   String
  descricao       String
  quantidade      Decimal
  unidade         String @default("UN")

  criadoEm        DateTime @default(now())
}

// Histórico de alterações (quem criou/editou o quê)
model LogAlteracao {
  id           String   @id @default(cuid())
  usuarioId    String?
  usuarioNome  String
  entidade     String   // Cliente, Avaria, PresencaCarga, MovimentoPallet, Usuario...
  entidadeId   String?
  acao         String   // CRIAR, EDITAR, EXCLUIR, RESETAR_SENHA...
  resumo       String   // descrição legível do que mudou
  criadoEm     DateTime @default(now())
}

// Inventário — ciclo completo de contagem de um cliente
model Inventario {
  id         String   @id @default(cuid())
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  clienteId  String

  nome       String   // ex: "Inventário Setembro/2026"
  status     String   @default("PREPARANDO") // PREPARANDO, EM_CONTAGEM, FINALIZADO
  criadoEm   DateTime @default(now())

  itens      InventarioItemEsperado[]
  rodadas    InventarioRodada[]
}

// Saldo esperado de cada produto/lote, subido via planilha antes de abrir o inventário
model InventarioItemEsperado {
  id             String     @id @default(cuid())
  inventario     Inventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  inventarioId   String

  descricao      String
  lote           String
  quantidadeEsperada Decimal

  // Observação prévia (tipo Radar), marcada pelo admin antes de liberar pro conferente
  tipoObservacao String?  // JA_TRATADO, TRATATIVA_ADMINISTRATIVA, OUTRO
  observacao     String?

  criadoEm       DateTime @default(now())

  contagens      InventarioContagem[]
}

// Uma rodada de contagem (1ª, 2ª recontagem, 3ª...) dentro de um inventário
model InventarioRodada {
  id           String     @id @default(cuid())
  inventario   Inventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  inventarioId String

  numero       Int      // 1, 2, 3...
  status       String   @default("ABERTA") // ABERTA, FECHADA
  criadoEm     DateTime @default(now())
  fechadaEm    DateTime?

  contagens    InventarioContagem[]
}

// Cada apontamento do conferente: quanto ele contou de um item esperado, numa rodada
model InventarioContagem {
  id             String                  @id @default(cuid())
  rodada         InventarioRodada        @relation(fields: [rodadaId], references: [id], onDelete: Cascade)
  rodadaId       String
  itemEsperado   InventarioItemEsperado  @relation(fields: [itemEsperadoId], references: [id], onDelete: Cascade)
  itemEsperadoId String

  quantidadeContada Decimal
  localizacao       String? // onde o conferente encontrou o item — ajuda numa recontagem
  conferenteNome    String
  conferenteId      String?

  criadoEm       DateTime @default(now())
}
